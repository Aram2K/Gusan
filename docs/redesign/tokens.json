{
  "_about": "Gusan cross-platform design tokens (proposal). Units are Qt logical px (= Windows epx at 100% scale = macOS pt). Colors are opaque sRGB so QSS never has to alpha-blend over unknown native backgrounds. Contrast ratios computed by contrast.py in this folder (WCAG 2.x relative luminance).",
  "font": {
    "family": {
      "windows": ["Segoe UI Variable Text", "Segoe UI"],
      "windows_display": ["Segoe UI Variable Display", "Segoe UI"],
      "macos": "QFontDatabase.systemFont(QFontDatabase.GeneralFont)  (SF Pro, .AppleSystemUIFont)",
      "mono": {"windows": ["Cascadia Mono", "Consolas"], "macos": "QFontDatabase.systemFont(QFontDatabase.FixedFont)  (SF Mono / Menlo)"}
    },
    "weight": {"regular": 400, "semibold": 600, "bold_macos_titles": 700},
    "ramp": {
      "caption":     {"windows": [12, 16, 400], "macos": [11, 14, 400], "use": "timestamps, helper text, badges, shortcut hints. Floor: never smaller."},
      "body":        {"windows": [14, 20, 400], "macos": [13, 16, 400], "use": "default UI text, list primary text, transcript text"},
      "body_strong": {"windows": [14, 20, 600], "macos": [13, 16, 600], "use": "settings group headers, card titles, list headers"},
      "body_large":  {"windows": [18, 24, 400], "macos": [15, 20, 400], "use": "live transcript/Live Assist answer text, empty-state lead"},
      "subtitle":    {"windows": [20, 28, 600], "macos": [17, 22, 600], "use": "section/page sub-headers, dialog titles"},
      "title":       {"windows": [28, 36, 600], "macos": [22, 26, 700], "use": "page titles (one per page)"},
      "title_large": {"windows": [40, 52, 600], "macos": [26, 32, 700], "use": "onboarding hero, paywall headline only"}
    },
    "rules": ["sentence case everywhere", "no italic, no bold in body (use semibold)", "left-aligned", "50-60 chars per line for long text (cap transcript column ~720px)", "retire all 10-11px text on Windows"]
  },
  "space": {
    "scale": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 56],
    "semantic": {
      "control_gap": 8,
      "header_to_control": 8,
      "label_to_control": 12,
      "card_gap": 4,
      "group_gap": 12,
      "surface_padding": 16,
      "card_padding_h": 16,
      "card_padding_v": 12,
      "page_margin": 24,
      "page_margin_narrow": 12,
      "section_gap": 32,
      "expander_child_indent": 48,
      "settings_max_width": 1000,
      "reading_max_width": 720
    }
  },
  "radius": {
    "none": 0,
    "control": {"windows": 4, "macos": 6, "use": "buttons, inputs, combos, checkboxes, list/nav backplates, tooltips, progress/slider tracks"},
    "surface": 8,
    "surface_use": "cards, menus, flyouts, popups, dialogs, content-layer top-left corner",
    "floating": 12,
    "floating_use": "free-floating HUDs we paint ourselves: dictation pill, done toast, Live Assist card",
    "pill": 999,
    "rules": ["concentric: inner radius = outer radius - padding (min 4)", "0 where two elements touch (split button halves, attached dropdowns)", "top-level window corners are the OS's job: DWMWA_WINDOW_CORNER_PREFERENCE on Win11, system frame on macOS"]
  },
  "size": {
    "control_height": 32,
    "control_height_compact": 24,
    "min_target": 24,
    "icon_button": 32,
    "nav_item_height": 36,
    "nav_rail_width": 48,
    "nav_pane_width": 240,
    "nav_selection_indicator": [3, 16, 2],
    "toggle": [40, 20],
    "icon": {"inline": 16, "nav_and_buttons": 20, "list_leading": 24, "empty_state": 48},
    "focus_ring": {"outer": 2, "inner_gap": 1, "offset": 1}
  },
  "elevation": {
    "_note": "Fluent 2 shadow recipe: ambient + key. Light ambient rgba(0,0,0,.12) key rgba(0,0,0,.14); dark ambient .24 key .28. In Qt Widgets prefer 1px strokes for in-window depth and native OS shadows for top-level popups; paint shadows only on our own frameless HUDs.",
    "e0_base":    {"use": "window background", "shadow": "none", "stroke": false},
    "e1_card":    {"use": "settings cards, list rows, meeting cards", "shadow": "none", "stroke": "stroke.card 1px"},
    "e2_raised":  {"use": "hovered draggable card, segmented selected thumb", "shadow": "0 0 2 ambient, 0 2 4 key (shadow4)"},
    "e3_flyout":  {"use": "menus, combo popups, tooltips, tray flyout", "shadow": "OS native (DWM / NSWindow) else 0 0 2 ambient, 0 8 16 key (shadow16)"},
    "e4_overlay": {"use": "dialogs, dictation pill, Live Assist card", "shadow": "0 0 8 ambient, 0 14 28 key (shadow28); dialogs 0 0 8, 0 32 64 (shadow64)"}
  },
  "color": {
