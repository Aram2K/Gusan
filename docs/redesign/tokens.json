  },
  "motion": {
    "duration": {"instant": 0, "faster": 83, "fast": 167, "normal": 250, "slow": 333},
    "easing": {"enter": "cubic-bezier(0,0,0,1)  (QEasingCurve BezierSpline / OutExpo-like)", "exit": "cubic-bezier(1,0,1,1) accelerate", "standard": "cubic-bezier(0.33,0,0.67,1)"},
    "use": {"hover_press": "faster", "fade_toast_tooltip": "fast", "overlay_enter": "normal", "page_or_sheet": "normal", "exit": "fast"},
    "reduced_motion": "all movement -> 0ms or opacity-only crossfade <= 83ms; no looping pulses (recording dot becomes static + label). Win: SystemParametersInfo(SPI_GETCLIENTAREAANIMATION 0x1042). macOS: NSWorkspace.accessibilityDisplayShouldReduceMotion"
  }
}
