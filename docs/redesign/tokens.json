    "glass_worst_case": {
      "_rule": "plate opacity >= 0.86 light / >= 0.82 dark keeps text.secondary >= 4.5:1 over pure black, white or grey behind the card",
      "light 0.86 secondary over black": 4.60,
      "dark 0.82 secondary over white": 5.87,
      "light 0.72 secondary over black (fails)": 3.19,
      "dark 0.70 secondary over white (fails)": 3.86
