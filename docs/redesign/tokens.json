      "pro.on/pro.fill": 5.70, "pro.text/bg.card": 7.10,
      "record.on/record.fill": 5.66, "record.text/bg.card": 6.57,
      "success/bg.card": 5.44, "caution/bg.card": 5.25,
      "stroke.strong/bg.card (non-text 3:1)": 3.45, "stroke.strong/bg.base": 3.11,
      "accent.fill/bg.card (checkbox, toggle-on)": 5.17,
      "focus.outer/bg.card": 17.22, "focus.outer/accent.fill": 3.33
    },
    "contrast_dark": {
