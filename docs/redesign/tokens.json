    },
    "contrast_light": {
      "text.primary/bg.base": 15.52, "text.primary/bg.card": 17.22,
      "text.secondary/bg.base": 6.03, "text.secondary/bg.card": 6.69,
      "text.tertiary/bg.base": 4.60, "text.tertiary/bg.card": 5.10,
      "accent.on/accent.fill": 5.17, "accent.on/accent.fill_hover": 6.70,
